models/
bench/data/
bench/out/
.build/
*.wav
*.m4a

# Python / editor / OS noise
.venv/
__pycache__/
*.pyc
.DS_Store
.claude/

# User content. Recordings, transcripts and summaries live in
# ~/Library/Application Support/Scribebot/ and must never be committed;
# these patterns are belt-and-braces for anything copied into the tree.
*.txt
!RECORDINGS.md
recordings/
audio/
docs/progress.html

# a mistyped "record 10" wrote CoreAudio audio to a file named 10
/10
*.caf

# agent tool state
.serena/

# Per-recording capture diagnostics. These live beside the audio in
# ~/Library/Application Support/Scribebot/, but they name the user's audio
# devices, so keep them out of the tree if one is ever copied in.
*.capture.log

# Calendar-derived data. bench/meetings.json holds 439 real meetings and 850
# attendee names; vocab.json and vocab_clean.json are harvested from the same
# source. All three were committed and public before anyone noticed, and the
# history had to be rewritten to remove them. They stay on the machine that
# generated them and never in the repository again.
bench/meetings.json
bench/vocab.json
bench/vocab_clean.json
